{
  "name": "hand-frame-cell-shade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "assets:anime": "swift scripts/build-anime-face-assets.swift && node scripts/build-anime-face-webp.mjs",
    "assets:anime:webp": "node scripts/build-anime-face-webp.mjs",
    "assets:anime:verify": "swift scripts/verify-anime-face-assets.swift && swift scripts/verify-anime-face-reproducibility.swift",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@pixi/react": "^8.0.5",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
